{
  "version": "4.2",
  "name": "Professional dashboard trading workflow",
  "objective": "每天只筛选 1-2 笔最合适的限价机会；由 AI 综合判断挂单、止损、仓位与风险，不使用固定分数或固定 RR 一票否决。",
  "max_daily_new_positions": 2,
  "preferred_new_positions": 1,
  "only_best_candidates": true,
  "max_ranked_candidates": 8,
  "minimum_confidence": null,
  "minimum_rr": null,
  "allow_partial_position": true,
  "execution_style": "limit_only",
  "avoid_market_orders": true,
  "preferred_cash_ratio": 0.35,
  "minimum_cash_after_new_trades_pct": 30,
  "market_score_policy": {
    "mode": "advisory_only",
    "hard_gate": false
  },
  "rr_policy": {
    "mode": "ai_dynamic",
    "hard_gate": false,
    "reference_rr": 2.2
  },
  "committee_policy": {
    "mode": "ai_dynamic",
    "hard_gate": false,
    "reference_score": 85
  },
  "new_position_sizing": {
    "mode": "ai_dynamic_with_market_context",
    "strong_risk_on_reference_pct": 25,
    "risk_on_reference_pct": 18,
    "neutral_reference_pct": 10,
    "risk_off_reference_pct": 5,
    "extreme_risk_off_reference_pct": 0,
    "description": "Reference sizes only. AI chooses final size from entry quality, stop distance, cash, concentration, events and current exposure."
  },
  "order_instruction_policy": {
    "enabled": true,
    "requires_broker_snapshot": true,
    "requires_defined_stop": true,
    "requires_rr_above_minimum": false,
    "requires_investment_committee_approval": false,
    "requires_market_score_threshold": false,
    "ai_discretionary_approval": true,
    "note": "只要 AI 判断限价、止损、仓位和风险组合合适，就可以创建非 live 的 IBKR order instruction；最终仍需用户在 IBKR 客户端确认。"
  },
  "no_trade_report": {
    "enabled": true,
    "required_when_no_order": true,
    "include_reasons": ["entry_price_unattractive", "stop_structure_invalid", "event_risk", "gap_too_extended", "cash_or_concentration_limit", "quote_unavailable", "ai_declined"]
  }
}